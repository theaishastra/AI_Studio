# Template for mcp_server/.env. Copy to mcp_server/.env and fill in the <...> values.
# STUDIO_EMAIL should be an owner account to get logins and user actions.
STUDIO_API_URL=http://127.0.0.1:8000
STUDIO_EMAIL=owner@saikumarstudio.in
STUDIO_PASSWORD=<from password manager>
MCP_API_KEYS=<one key per person, comma-separated>
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_ALLOWED_HOSTS=
